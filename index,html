  </div>
</section>

<section class="section">
  <h2 class="tamil">அன்புடன் அழைக்கிறோம்!</h2>
  <h2 class="english">We Await Your Presence</h2>
  <p class="tamil">
    தங்களின் பொன்னான வருகையால்<br>
    எங்கள் விழாவினை சிறப்பிக்குமாறு<br>
    அன்புடன் கேட்டுக்கொள்கிறோம்.
  </p>
  <p>With Love & Blessings ❤️</p>

  <button onclick="shareInvitation()">
    💌 Share via WhatsApp
  </button>

  <button onclick="window.print()">
    🖨️ Print Invitation
  </button>
</section>

<footer>
  <div style="font-size:35px">🪷</div>
  <p class="english">Ragavi & Selvam</p>
  <p class="tamil">உங்கள் வருகையை அன்புடன் எதிர்பார்க்கிறோம்.</p>
  <p>13 • 12 • 2026</p>
  <p style="font-size:12px">Made with Love ❤️</p>
</footer>

</main>

<script>

// Engagement date and time (Indian Standard Time)
const eventDate = new Date("2026-12-13T10:30:00+05:30");

// Venue location
const venue = "Mangalam Mahal, Sendurai Road, Jayankondam, Ariyalur, Tamil Nadu, India";

document.getElementById("mapLink").href =
"https://www.google.com/maps/search/?api=1&query=" +
encodeURIComponent(venue);

// Open invitation
function openInvitation() {
  document.getElementById("opening").style.display = "none";
  document.getElementById("invitation").style.display = "block";
  window.scrollTo(0,0);
}

// Countdown
function updateCountdown() {
  const now = new Date();
  const diff = eventDate - now;

  if (diff <= 0) {
    document.querySelector(".countdown").innerHTML =
    "<h2>Our Special Day is Here! ❤️</h2>";
    return;
  }

  document.getElementById("days").textContent =
  Math.floor(diff / 86400000);

  document.getElementById("hours").textContent =
  Math.floor(diff / 3600000) % 24;

  document.getElementById("minutes").textContent =
  Math.floor(diff / 60000) % 60;

  document.getElementById("seconds").textContent =
  Math.floor(diff / 1000) % 60;
}

updateCountdown();
setInterval(updateCountdown,1000);

// WhatsApp share
function shareInvitation() {
  const message =
  "💍 We're Getting Engaged! 💍\n\n" +
  "Dr. V. Ragavi ❤️ Dr. R. Selvam\n\n" +
  "📅 13 December 2026\n" +
  "🕥 10:30 AM - 12:30 PM\n" +
  "📍 Mangalam Mahal, Sendurai Road, Jayankondam, Ariyalur\n\n" +
  "Please join us and bless us!\n\n" +
  window.location.href;

  window.open(
    "https://wa.me/?text=" + encodeURIComponent(message),
    "_blank"
  );
}
</script>

</body>
</html>
